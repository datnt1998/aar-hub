{
  "name": "aar-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint //#lint:root",
    "lint:root": "eslint eslint.config.js .devkit/scripts && node .devkit/scripts/check.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:api": "turbo run test --filter=api",
    "test:web": "turbo run test --filter=web",
    "e2e": "turbo run e2e",
    "build": "turbo run build",
    "openapi": "turbo run api:types --filter=web",
    "openapi:check": "turbo run openapi:check api:types:check",
    "db:check": "pnpm --filter api db:check",
    "ac": "node .devkit/scripts/ac-tests.mjs",
    "devkit:check": "node .devkit/scripts/check.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm e2e && pnpm build && pnpm openapi:check && pnpm db:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
