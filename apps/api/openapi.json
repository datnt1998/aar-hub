{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "Health_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/partner-applications/attachments": {
      "post": {
        "description": "Bước trước khi nộp đơn. Dùng id trả về trong businessRegistrationAttachmentId / otherAttachmentIds. Không cần tài khoản. File tối đa 10485760 byte.",
        "operationId": "PartnerApplications_uploadAttachment",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attachment"
                }
              }
            }
          },
          "400": {
            "description": "PARTNER_APPLICATION_FILE_REQUIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PARTNER_APPLICATION_FILE_REQUIRED"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PAYLOAD_TOO_LARGE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "summary": "Tải lên một file đính kèm",
        "tags": [
          "partner-applications"
        ]
      }
    },
    "/api/partner-applications/organization": {
      "post": {
        "description": "Không cần tài khoản. Thành công: đơn ở SUBMITTED; email xác nhận gửi tới email liên hệ trong đơn; thông báo trong AarHub chỉ gửi tới tài khoản gắn với đơn (đơn gắn tài khoản khi có đăng nhập, chưa nối vào API); mọi admin nền tảng nhận email và thông báo trong AarHub. Trùng mã số thuế với đối tác hoặc đơn đang mở vẫn được nhận và không có cảnh báo nào trong phản hồi. Lỗi: không có đơn nào được tạo.",
        "operationId": "PartnerApplications_submitOrganization",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganizationApplicationCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApplication"
                }
              }
            }
          },
          "422": {
            "description": "PARTNER_APPLICATION_BUSINESS_REGISTRATION_INVALID, PARTNER_APPLICATION_OTHER_ATTACHMENT_INVALID",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PARTNER_APPLICATION_BUSINESS_REGISTRATION_INVALID",
                            "PARTNER_APPLICATION_OTHER_ATTACHMENT_INVALID"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "summary": "Nộp đơn đăng ký đối tác hình thức tổ chức",
        "tags": [
          "partner-applications"
        ]
      }
    }
  },
  "info": {
    "title": "aar-hub API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "API process is up and serving requests"
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Seconds since the API process started"
          }
        },
        "required": [
          "status",
          "uptimeSeconds"
        ],
        "additionalProperties": false
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fileName": {
            "type": "string",
            "description": "Tên file gốc"
          },
          "contentType": {
            "type": "string",
            "description": "MIME type do client gửi lên"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "fileName",
          "contentType",
          "sizeBytes"
        ],
        "additionalProperties": false
      },
      "OrganizationApplicationCreateRequest": {
        "type": "object",
        "properties": {
          "contactName": {
            "type": "string",
            "minLength": 1,
            "description": "Họ tên người nộp đơn (người liên hệ)"
          },
          "contactEmail": {
            "description": "Email liên hệ của người nộp đơn",
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "legalName": {
            "type": "string",
            "minLength": 1,
            "description": "Tên pháp nhân"
          },
          "taxId": {
            "type": "string",
            "minLength": 1,
            "description": "Mã số thuế của pháp nhân"
          },
          "sellOnly": {
            "default": false,
            "description": "Chọn \"chỉ bán hàng\": không cần khai báo nghệ sĩ dự kiến",
            "type": "boolean"
          },
          "plannedArtists": {
            "default": [],
            "description": "Nghệ sĩ dự kiến. Bắt buộc ít nhất một nghệ sĩ khi sellOnly là false.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlannedArtist"
            }
          },
          "businessRegistrationAttachmentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Id file giấy đăng ký kinh doanh, lấy từ POST /api/partner-applications/attachments"
          },
          "otherAttachmentIds": {
            "default": [],
            "description": "Id các file hồ sơ khác (tùy chọn), tối đa 2: cả đơn tối đa 3 file, tính cả giấy đăng ký kinh doanh. Mỗi file chỉ dùng một lần trong đơn.",
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "contactName",
          "contactEmail",
          "legalName",
          "taxId",
          "businessRegistrationAttachmentId"
        ],
        "additionalProperties": false
      },
      "PlannedArtist": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Tên nghệ sĩ dự kiến",
            "example": "Nguyễn Văn A"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "PartnerApplication": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "type": {
            "type": "string",
            "enum": [
              "ORGANIZATION"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED"
            ]
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "contactName": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "legalName": {
            "type": "string"
          },
          "taxId": {
            "type": "string"
          },
          "sellOnly": {
            "type": "boolean"
          },
          "plannedArtists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlannedArtist"
            }
          },
          "businessRegistration": {
            "$ref": "#/components/schemas/Attachment"
          },
          "otherAttachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attachment"
            }
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "submittedAt",
          "contactName",
          "contactEmail",
          "legalName",
          "taxId",
          "sellOnly",
          "plannedArtists",
          "businessRegistration",
          "otherAttachments"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Problem type URI; `about:blank` when `code` is enough"
          },
          "title": {
            "type": "string",
            "description": "HTTP reason phrase of `status`"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "HTTP status code"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code; clients branch and translate on this",
            "example": "VALIDATION_FAILED"
          },
          "detail": {
            "description": "English explanation for developers; never shown as UI text",
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "Request path that produced the error"
          },
          "errors": {
            "description": "Per-input errors when `code` is VALIDATION_FAILED",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance"
        ],
        "additionalProperties": false,
        "description": "Error response (RFC 9457 Problem Details) with a required `code`"
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "description": "JSON Pointer (RFC 6901) to the invalid input, prefixed by its location: `/body/email`, `/query/page`, `/path/id`",
            "example": "/body/email"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable reason (schema issue code such as `too_small`, `invalid_format`)",
            "example": "invalid_format"
          },
          "detail": {
            "type": "string",
            "description": "English explanation for developers; clients show their own text"
          }
        },
        "required": [
          "pointer",
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  }
}
