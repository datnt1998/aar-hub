{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "Health_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/partner-applications": {
      "post": {
        "description": "Không cần tài khoản. Một lần gửi multipart/form-data gồm thông tin đơn và các tệp; không có bước tải tệp lên trước. Hệ thống kiểm số tệp, định dạng (theo nội dung) và dung lượng của mọi tệp cùng mọi trường khác, báo mọi chỗ sai trong một lần (400 VALIDATION_FAILED); đơn hợp lệ thì quét mã độc từng tệp rồi mới nhận đơn. Tệp nhiễm mã độc: 422 PARTNER_APPLICATION_FILE_INFECTED; chưa quét được: 503 PARTNER_APPLICATION_FILE_SCAN_UNAVAILABLE, thử lại sau; errors[].pointer chỉ tệp bị từ chối (code infected hoặc not_scanned). Thành công: đơn ở SUBMITTED cùng các tệp; email xác nhận gửi tới email liên hệ trong đơn, người nộp đơn không nhận thông báo trong AarHub; mọi admin nền tảng nhận email và thông báo trong AarHub. Trùng mã số thuế với đối tác hoặc đơn đang mở vẫn được nhận và phản hồi không có cảnh báo nào. Lỗi: không có đơn nào được tạo và không tệp nào được lưu. Quá 10 tệp hoặc 100 trường chữ: 400 BAD_REQUEST.",
        "operationId": "PartnerApplications_submitOrganization",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/OrganizationApplicationCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApplication"
                }
              }
            }
          },
          "422": {
            "description": "PARTNER_APPLICATION_FILE_INFECTED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PARTNER_APPLICATION_FILE_INFECTED"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "PARTNER_APPLICATION_FILE_SCAN_UNAVAILABLE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PARTNER_APPLICATION_FILE_SCAN_UNAVAILABLE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "summary": "Nộp đơn đăng ký đối tác hình thức tổ chức, kèm tệp",
        "tags": [
          "partner-applications"
        ]
      }
    }
  },
  "info": {
    "title": "aar-hub API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "API process is up and serving requests"
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Seconds since the API process started"
          }
        },
        "required": [
          "status",
          "uptimeSeconds"
        ],
        "additionalProperties": false
      },
      "OrganizationApplicationCreateRequest": {
        "type": "object",
        "properties": {
          "legalForm": {
            "type": "string",
            "enum": [
              "tổ chức"
            ],
            "description": "Hình thức nộp đơn. Endpoint này chỉ nhận đơn \"tổ chức\"; \"cá nhân\" thuộc use case khác nên bị từ chối ở trường này."
          },
          "applicantName": {
            "minLength": 1,
            "maxLength": 255,
            "description": "Họ tên người nộp đơn, 1–255 ký tự, không chỉ gồm khoảng trắng",
            "type": "string"
          },
          "contactEmail": {
            "minLength": 1,
            "maxLength": 254,
            "format": "email",
            "description": "Email liên hệ, tối đa 254 ký tự. Khoảng trắng hai đầu được bỏ trước khi kiểm và không được lưu. Đúng một dấu @, có ít nhất một ký tự trước @, phần sau @ có dấu chấm nhưng không bắt đầu và không kết thúc bằng dấu chấm, không có khoảng trắng; so khớp không phân biệt hoa thường",
            "type": "string"
          },
          "legalName": {
            "minLength": 1,
            "maxLength": 255,
            "description": "Tên pháp nhân, 1–255 ký tự, không chỉ gồm khoảng trắng",
            "type": "string"
          },
          "taxCode": {
            "minLength": 10,
            "maxLength": 13,
            "pattern": "^([0-9]{10}|[0-9]{13})$",
            "description": "Mã số thuế: đúng 10 hoặc 13 chữ số, không gạch nối, không dấu cách ở giữa. Khoảng trắng hai đầu được bỏ trước khi kiểm và không được lưu",
            "type": "string"
          },
          "businessRegistration": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "binary"
            },
            "minItems": 1,
            "description": "Giấy đăng ký kinh doanh: đúng 1 tệp, gửi cùng đơn. pdf, jpg hoặc png nhận theo nội dung tệp, không theo đuôi tên; mỗi tệp tối đa 10485760 byte (10 MB). Cả đơn tối đa 3 tệp. Tệp sai định dạng: invalid_format tại /body/<trường>/<thứ tự>; tệp quá lớn: too_big tại /body/<trường>/<thứ tự>; quá số tệp: too_big tại /body/<trường>. Bỏ trống: invalid_type; danh sách rỗng: too_small"
          },
          "otherDocuments": {
            "description": "Hồ sơ khác (tùy chọn): tối đa 2 tệp, mỗi tệp một phần form cùng tên otherDocuments, gửi cùng đơn. pdf, jpg hoặc png nhận theo nội dung tệp, không theo đuôi tên; mỗi tệp tối đa 10485760 byte (10 MB). Cả đơn tối đa 3 tệp. Tệp sai định dạng: invalid_format tại /body/<trường>/<thứ tự>; tệp quá lớn: too_big tại /body/<trường>/<thứ tự>; quá số tệp: too_big tại /body/<trường>",
            "type": "array",
            "items": {
              "type": "string",
              "format": "binary"
            }
          },
          "salesOnly": {
            "description": "Chọn \"chỉ bán hàng\" (\"true\"/\"false\"): không cần khai báo nghệ sĩ dự kiến. Mặc định \"false\".",
            "default": "false",
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          },
          "declaredArtists": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "description": "Tên nghệ sĩ dự kiến, mỗi tên một phần form cùng tên declaredArtists; 20 mục tối đa, mỗi tên 1–255 ký tự. Bắt buộc ít nhất một khi salesOnly là false."
          }
        },
        "required": [
          "legalForm",
          "applicantName",
          "contactEmail",
          "legalName",
          "taxCode",
          "businessRegistration"
        ],
        "additionalProperties": false
      },
      "PartnerApplication": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "legalForm": {
            "type": "string",
            "enum": [
              "tổ chức",
              "cá nhân"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED"
            ]
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "applicantName": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "legalName": {
            "type": "string"
          },
          "taxCode": {
            "type": "string"
          },
          "salesOnly": {
            "type": "boolean"
          },
          "declaredArtists": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "legalForm",
          "status",
          "submittedAt",
          "applicantName",
          "contactEmail",
          "legalName",
          "taxCode",
          "salesOnly",
          "declaredArtists"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Problem type URI; `about:blank` when `code` is enough"
          },
          "title": {
            "type": "string",
            "description": "HTTP reason phrase of `status`"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "HTTP status code"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code; clients branch and translate on this",
            "example": "VALIDATION_FAILED"
          },
          "detail": {
            "description": "English explanation for developers; never shown as UI text",
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "Request path that produced the error"
          },
          "errors": {
            "description": "Per-input errors: every invalid input when `code` is VALIDATION_FAILED; the inputs a business error is about for the codes that name them",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance"
        ],
        "additionalProperties": false,
        "description": "Error response (RFC 9457 Problem Details) with a required `code`"
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "description": "JSON Pointer (RFC 6901) to the invalid input, prefixed by its location: `/body/email`, `/query/page`, `/path/id`",
            "example": "/body/email"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable reason: a schema issue code such as `too_small`, `invalid_format`; for a business error, the reason its route documents (`infected`)",
            "example": "invalid_format"
          },
          "detail": {
            "type": "string",
            "description": "English explanation for developers; clients show their own text"
          }
        },
        "required": [
          "pointer",
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  }
}
