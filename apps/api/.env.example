# Copy to .env for local runs. Every variable is validated by src/config/env.ts.
NODE_ENV=development
PORT=3000
# PostgreSQL for local runs and `pnpm --filter api db:migrate`; tests use in-process PGlite instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aar_hub
# ClamAV daemon (clamd) that scans every attached file (ADR 0007). Without it, applications with files are refused
# with PARTNER_APPLICATION_FILE_SCAN_UNAVAILABLE. Local: docker run -d -p 3310:3310 clamav/clamav-debian
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=30000
